{
  "name": "helm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --color '**/*.@(ts|tsx)'",
    "prettier:format": "prettier --ignore-path .gitignore --write \"./src/**/*.{ts,tsx,js,css,scss,html,json}\"",
    "format": "bun prettier:format && bun lint --fix",
    "db:generate": "drizzle-kit generate",

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/helm
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000

# Resend config
RESEND_API_KEY=re_...
# Must use a domain verified in Resend for production sends.
RESEND_FROM_EMAIL="Mladi Pirati <noreply@verified-domain.example>"

# Keycloak Options
KEYCLOAK_CLIENT_ID=helm
KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret
KEYCLOAK_ISSUER=https://auth.piratskastranka.si/auth/realms/mladipirati
KEYCLOAK_ADMIN=https://auth.piratskastranka.si/admin/realms/mladipirati
KEYCLOAK_DEFAULT_CLIENT_ROLE=user

LEGALIZIRAJMO_TURNSTILE_SECRET_KEY=replace-with-your-cloudflare-turnstile-secret
LEGALIZIRAJMO_LEGALIZIRAJMO_TURNSTILE_EXPECTED_HOSTNAME=legalizirajmo.si

MP_TURNSTILE_SECRET_KEY=replace-with-your-other-cloudflare-turnstile-secret
MP_LEGALIZIRAJMO_TURNSTILE_EXPECTED_HOSTNAME=mladipirati.si

# Docker Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=helm

# Automation
# Shared with piratosan-discord, which stores it as HELM_API_SECRET
DISCORD_LINK_API_SECRET=replace-with-shared-bearer-secret
DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
DISCORD_BOT_URL=
DISCORD_BOT_SECRET=replace-with-shared-bearer-secret
ADMIN_HOST=https://ingest.example.com

# S3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=garage
S3_ENDPOINT=https://s3.mladipirati.si
S3_BUCKET=helm
